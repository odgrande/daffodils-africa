{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/chat.js": {
      "runtime": "nodejs18.x",
      "memory": 256,
      "maxDuration": 15
    },
    "api/blog.js": {
      "runtime": "nodejs18.x",
      "memory": 256,
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
